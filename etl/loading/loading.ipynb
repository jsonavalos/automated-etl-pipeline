SERVER = "ads-5070-server.database.windows.net"
DB_NAME = "ads-507-db"
USERNAME = "ads507"
PASSWORD = "EQTe4j2QSx@W6Qc"

films_clean_path = "../transformation/transformed_data/films_clean_data.csv"
oscars_clean_path = "../transformation/transformed_data/oscars_clean_data.csv"
streaming_clean_path = "../transformation/transformed_data/streaming_clean_data.csv"

films_clean_df = pd.read_csv(films_clean_path)
oscars_clean_df = pd.read_csv(oscars_clean_path)
streaming_clean_df = pd.read_csv(streaming_clean_path)

print("films_clean_df:", films_clean_df.shape)
print("oscars_clean_df:", oscars_clean_df.shape)
print("streaming_clean_df:", streaming_clean_df.shape)

connection_string = (
    f"Server=tcp:{SERVER};"
    f"Database={DB_NAME};"
    f"UID={USERNAME};"
    f"PWD={PASSWORD};"
    "Encrypt=yes;TrustServerCertificate=no;"
)

def get_conn():
    conn = connect(connection_string)
    conn.setautocommit(True)
    return conn

conn = get_conn()
cursor = conn.cursor()
cursor.execute("SELECT DB_NAME();")
print("Connected to:", cursor.fetchone())

cursor.execute("""
IF OBJECT_ID('dbo.test_connection_table', 'U') IS NULL
BEGIN
    CREATE TABLE dbo.test_connection_table (
        id INT IDENTITY(1,1) PRIMARY KEY,
        note VARCHAR(50) NOT NULL,
        created_at DATETIME2 NOT NULL DEFAULT SYSUTCDATETIME()
    );
END
""")

cursor.execute("INSERT INTO dbo.test_connection_table (note) VALUES ('hello');")
cursor.execute("SELECT TOP 5 * FROM dbo.test_connection_table ORDER BY id DESC;")
print("Recent test rows:", cursor.fetchall())

cursor.execute("""
IF OBJECT_ID('dbo.film_genre','U') IS NULL
CREATE TABLE dbo.film_genre(
    film_genre_id INT IDENTITY(1,1) PRIMARY KEY,
    genre_name VARCHAR(100) NOT NULL UNIQUE
);

IF OBJECT_ID('dbo.streaming_service','U') IS NULL
CREATE TABLE dbo.streaming_service(
    streaming_service_id INT IDENTITY(1,1) PRIMARY KEY,
    service_name VARCHAR(120) NOT NULL UNIQUE
);

IF OBJECT_ID('dbo.film','U') IS NULL
CREATE TABLE dbo.film(
    film_id INT IDENTITY(1,1) PRIMARY KEY,
    film_title VARCHAR(300) NOT NULL,
    film_year INT NULL,
    film_genre_id INT NULL,
    CONSTRAINT FK_film_genre FOREIGN KEY (film_genre_id) REFERENCES dbo.film_genre(film_genre_id),
    CONSTRAINT UQ_film_title_year UNIQUE (film_title, film_year)
);

IF OBJECT_ID('dbo.film_streaming','U') IS NULL
CREATE TABLE dbo.film_streaming(
    film_streaming_id INT IDENTITY(1,1) PRIMARY KEY,
    film_id INT NOT NULL,
    streaming_service_id INT NOT NULL,
    CONSTRAINT FK_film_streaming_film FOREIGN KEY (film_id) REFERENCES dbo.film(film_id),
    CONSTRAINT FK_film_streaming_service FOREIGN KEY (streaming_service_id) REFERENCES dbo.streaming_service(streaming_service_id),
    CONSTRAINT UQ_film_service UNIQUE (film_id, streaming_service_id)
);
""")

print("Core normalized tables ensured.")

def guess_col(df, candidates):
    cols = {c.lower(): c for c in df.columns}
    for cand in candidates:
        if cand.lower() in cols:
            return cols[cand.lower()]
    return None

film_title_col = guess_col(films_clean_df, ["title", "film_title", "name"])
film_year_col  = guess_col(films_clean_df, ["year", "film_year", "release_year"])
genre_col      = guess_col(films_clean_df, ["genre", "genres", "film_genre"])

service_col    = guess_col(streaming_clean_df, ["service", "platform", "streaming_service", "provider"])
stream_title_col = guess_col(streaming_clean_df, ["title", "film_title", "name"])
stream_year_col  = guess_col(streaming_clean_df, ["year", "film_year", "release_year"])

if film_title_col is None:
    raise ValueError("Could not identify film title column.")
if service_col is None:
    raise ValueError("Could not identify streaming service column.")
if stream_title_col is None:
    raise ValueError("Could not identify film title column in streaming dataset.")

if genre_col is not None:
    unique_genres = films_clean_df[genre_col].dropna().astype(str).str.strip().unique()
    for g in unique_genres:
        cursor.execute(
            "IF NOT EXISTS (SELECT 1 FROM dbo.film_genre WHERE genre_name = ?) "
            "INSERT INTO dbo.film_genre(genre_name) VALUES (?)",
            (g, g)
        )

unique_services = streaming_clean_df[service_col].dropna().astype(str).str.strip().unique()
for s in unique_services:
    cursor.execute(
        "IF NOT EXISTS (SELECT 1 FROM dbo.streaming_service WHERE service_name = ?) "
        "INSERT INTO dbo.streaming_service(service_name) VALUES (?)",
        (s, s)
    )

cursor.execute("SELECT film_genre_id, genre_name FROM dbo.film_genre;")
genre_map = {name: gid for (gid, name) in cursor.fetchall()}

for _, r in films_clean_df.iterrows():
    title = str(r[film_title_col]).strip() if pd.notna(r[film_title_col]) else None
    year = int(r[film_year_col]) if (film_year_col and pd.notna(r[film_year_col])) else None
    if not title:
        continue

    g_id = None
    if genre_col and pd.notna(r.get(genre_col)):
        g_id = genre_map.get(str(r[genre_col]).strip())

    cursor.execute(
        """
        IF NOT EXISTS (
            SELECT 1 FROM dbo.film
            WHERE film_title = ?
              AND ((film_year IS NULL AND ? IS NULL) OR film_year = ?)
        )
        INSERT INTO dbo.film (film_title, film_year, film_genre_id)
        VALUES (?, ?, ?);
        """,
        (title, year, year, title, year, g_id)
    )

cursor.execute("SELECT film_id, film_title, film_year FROM dbo.film;")
film_key_to_id = {(t, y): fid for (fid, t, y) in cursor.fetchall()}

cursor.execute("SELECT streaming_service_id, service_name FROM dbo.streaming_service;")
svc_map = {name: sid for (sid, name) in cursor.fetchall()}

for _, r in streaming_clean_df.iterrows():
    t = str(r[stream_title_col]).strip() if pd.notna(r[stream_title_col]) else None
    y = int(r[stream_year_col]) if (stream_year_col and pd.notna(r[stream_year_col])) else None
    s = str(r[service_col]).strip() if pd.notna(r[service_col]) else None

    if not t or not s:
        continue

    film_id = film_key_to_id.get((t, y))
    svc_id = svc_map.get(s)

    if film_id and svc_id:
        cursor.execute(
            """
            IF NOT EXISTS (
                SELECT 1 FROM dbo.film_streaming
                WHERE film_id = ? AND streaming_service_id = ?
            )
            INSERT INTO dbo.film_streaming (film_id, streaming_service_id)
            VALUES (?, ?);
            """,
            (film_id, svc_id, film_id, svc_id)
        )

print("DONE")
