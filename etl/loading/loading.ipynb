# ===============================
# COMPLETE LOADING SCRIPT
# ===============================

import math
import re
import pandas as pd
from mssql_python import connect
import config

# -------------------------------
# 1. READ TRANSFORMED CSV FILES
# -------------------------------

films_clean_path = "../transformation/transformed_data/films_clean_data.csv"
oscars_clean_path = "../transformation/transformed_data/oscars_clean_data.csv"
streaming_clean_path = "../transformation/transformed_data/streaming_clean_data.csv"

films_df = pd.read_csv(films_clean_path)
oscars_df = pd.read_csv(oscars_clean_path)
streaming_df = pd.read_csv(streaming_clean_path)

# Standardize streaming imdb column name
if "imdbid" in streaming_df.columns and "imdb_id" not in streaming_df.columns:
    streaming_df = streaming_df.rename(columns={"imdbid": "imdb_id"})

print("Loaded rows:")
print("films_df    =", len(films_df))
print("oscars_df   =", len(oscars_df))
print("streaming_df=", len(streaming_df))

# -------------------------------
# 2. CONNECT TO AZURE SQL
# -------------------------------

connection_string = (
    f"Server=tcp:{config.SERVER};"
    f"Database={config.DB_NAME};"
    f"UID={config.USERNAME};"
    f"PWD={config.PASSWORD};"
    "Encrypt=yes;TrustServerCertificate=no;"
)

def get_conn():
    conn = connect(connection_string)
    conn.setautocommit(True)
    return conn

conn = get_conn()
cursor = conn.cursor()
cursor.execute("SELECT DB_NAME();")
print("Connected to DB:", cursor.fetchone()[0])

# -------------------------------
# 3. HELPER FUNCTIONS
# -------------------------------

def sql_safe_name(name: str) -> str:
    name = re.sub(r"[^0-9a-zA-Z_]", "_", str(name).strip())
    if re.match(r"^\d", name):
        name = f"col_{name}"
    return name

def pandas_dtype_to_sql(dtype) -> str:
    if pd.api.types.is_integer_dtype(dtype):
        return "BIGINT"
    if pd.api.types.is_float_dtype(dtype):
        return "FLOAT"
    if pd.api.types.is_bool_dtype(dtype):
        return "BIT"
    if pd.api.types.is_datetime64_any_dtype(dtype):
        return "DATETIME2"
    return "NVARCHAR(4000)"

def exec_sql(sql: str):
    cur = conn.cursor()
    cur.execute(sql)
    conn.commit()

# -------------------------------
# 4. CREATE STAGING SCHEMA
# -------------------------------

STAGING_SCHEMA = "stg"

exec_sql(f"""
IF SCHEMA_ID(N'{STAGING_SCHEMA}') IS NULL
BEGIN
    EXEC('CREATE SCHEMA [{STAGING_SCHEMA}]');
END;
""")

# -------------------------------
# 5. CREATE TABLES FROM DATAFRAMES
# -------------------------------

def create_table_from_df(schema: str, table: str, df: pd.DataFrame):
    cols = []
    for col in df.columns:
        col_name = sql_safe_name(col)
        col_type = pandas_dtype_to_sql(df[col].dtype)
        cols.append(f"    [{col_name}] {col_type} NULL")

    cols_sql = ",\n".join(cols)

    sql = f"""
IF OBJECT_ID(N'{schema}.{table}', N'U') IS NULL
BEGIN
    CREATE TABLE [{schema}].[{table}] (
{cols_sql}
    );
END;
"""
    exec_sql(sql)

create_table_from_df(STAGING_SCHEMA, "films_clean", films_df)
create_table_from_df(STAGING_SCHEMA, "oscars_clean", oscars_df)
create_table_from_df(STAGING_SCHEMA, "streaming_clean", streaming_df)

print("Tables ensured.")

# -------------------------------
# 6. TRUNCATE TABLES (SAFE RELOAD)
# -------------------------------

def truncate_table(schema: str, table: str):
    exec_sql(f"TRUNCATE TABLE [{schema}].[{table}];")

truncate_table(STAGING_SCHEMA, "films_clean")
truncate_table(STAGING_SCHEMA, "oscars_clean")
truncate_table(STAGING_SCHEMA, "streaming_clean")

print("Tables truncated for reload.")

# -------------------------------
# 7. BATCH INSERT FUNCTION
# -------------------------------

BATCH_SIZE = 500

def insert_dataframe(schema: str, table: str, df: pd.DataFrame):

    df_sql = df.copy()
    df_sql.columns = [sql_safe_name(c) for c in df_sql.columns]
    df_sql = df_sql.where(pd.notnull(df_sql), None)

    cols = [f"[{c}]" for c in df_sql.columns]
    placeholders = ", ".join(["?"] * len(cols))
    col_list = ", ".join(cols)

    insert_sql = f"""
    INSERT INTO [{schema}].[{table}] ({col_list})
    VALUES ({placeholders});
    """

    rows = list(df_sql.itertuples(index=False, name=None))
    total = len(rows)

    cur = conn.cursor()

    for start in range(0, total, BATCH_SIZE):
        batch = rows[start:start+BATCH_SIZE]
        for r in batch:
            cur.execute(insert_sql, r)
        conn.commit()

    print(f"Inserted {total} rows into {schema}.{table}")

# -------------------------------
# 8. LOAD DATA INTO TABLES
# -------------------------------

insert_dataframe(STAGING_SCHEMA, "films_clean", films_df)
insert_dataframe(STAGING_SCHEMA, "oscars_clean", oscars_df)
insert_dataframe(STAGING_SCHEMA, "streaming_clean", streaming_df)

# -------------------------------
# 9. VALIDATION
# -------------------------------

for tbl in ["films_clean", "oscars_clean", "streaming_clean"]:
    cursor.execute(f"SELECT COUNT(*) FROM [{STAGING_SCHEMA}].[{tbl}];")
    print(f"{STAGING_SCHEMA}.{tbl} rowcount =", cursor.fetchone()[0])

print("Loading complete.")
